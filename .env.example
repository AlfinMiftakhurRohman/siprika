APP_NAME=SIPRIKA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===== SIPRIKA =====
# Domain yang boleh dipindai, dipisah koma (subdomain ikut diizinkan). * atau kosong = semua domain.
SCAN_ALLOWED_DOMAINS=*
# Batas waktu pemeriksaan satu website (detik): Mode Standar dan Mode Cepat
SCAN_TARGET_TIMEOUT=2700
SCAN_QUICK_TARGET_TIMEOUT=600
SCAN_USER_AGENT="SIPRIKA/1.0 (Diskominfo Jember)"
# Path CA bundle (opsional). Kosong = CA bawaan sistem (Windows certificate store)
SCAN_CA_BUNDLE=
# Website dengan sertifikat valid untuk uji verifikasi TLS di siprika:install (bagian 22.5)
SCAN_TLS_SELFTEST_HOST=www.google.com

# Tool eksternal (opsional). Kosong = pemeriksaan dicatat NOT ASSESSED.
# Contoh Windows: NUCLEI_PATH="C:/Tools/nuclei.exe"
# Contoh lewat WSL (tanpa shell, argumen dikirim apa adanya): TESTSSL_PATH="wsl -d Ubuntu -e testssl.sh"
NUCLEI_PATH=
TESTSSL_PATH=
WHATWEB_PATH=
NMAP_PATH=
# Batas waktu per tool (detik), opsional
# NUCLEI_TIMEOUT=1800
# Maksimal request Nuclei per detik per website (blueprint bagian 26), bawaan 15
# NUCLEI_RATE_LIMIT=15
# Kecepatan mengulang template yang request-nya gagal (timeout), bawaan 10
# NUCLEI_RETRY_RATE_LIMIT=10
# Kecepatan setelah website memblokir (429, 5xx, halaman blokir WAF), bawaan 5
# NUCLEI_BLOCKED_RATE_LIMIT=5
# TESTSSL_TIMEOUT=420
# WHATWEB_TIMEOUT=120
# NMAP_TIMEOUT=300

# AI lokal llama-server (opsional). Jika mati, kolom deskriptif memakai teks katalog.
AI_ENABLED=false
AI_URL=http://127.0.0.1:8081
AI_MODEL=qwen2.5-7b-instruct.Q4_K_M.gguf
AI_TIMEOUT=60
# Perintah llama-server yang ikut dijalankan siprika:serve (opsional), contoh:
# Path relatif dihitung dari folder SIPRIKA (model dan llama.cpp di storage/app, tidak ikut git):
# AI_SERVER_COMMAND="storage/app/llama.cpp/llama-server.exe -m storage/app/models/qwen2.5-7b-instruct.Q4_K_M.gguf --host 127.0.0.1 --port 8081 -c 8192 -t 8 --no-webui"
AI_SERVER_COMMAND=

# OWASP ZAP daemon untuk passive scan Mode Standar (opsional). ZAP_API_KEY harus sama dengan api.key di perintah.
# ZAP_SERVER_COMMAND='java -Xmx512m -jar "C:/Program Files/ZAP/Zed Attack Proxy/zap-2.17.0.jar" -daemon -host 127.0.0.1 -port 8080 -config api.key=GANTI_KUNCI -config api.addrs.addr.name=127.0.0.1 -config api.addrs.addr.regex=false'
ZAP_URL=
ZAP_API_KEY=
ZAP_TIMEOUT=120
ZAP_SERVER_COMMAND=
